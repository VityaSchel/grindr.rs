{
  "editor.tabCompletion": "on",
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "editor.indentSize": 4,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "rust-analyzer.diagnostics.disabled": ["unlinked-file"]
}
